.DS_Store
tmp*
config.local.json
__pycache__/
*.pyc

# Local, uncommitted helper scripts (not part of the build pipeline).
export_review_sheet.py

# Generated by build.py — regenerated by CI on every push, for both GitHub Pages
# (.github/workflows/build-and-deploy.yml) and GitLab Pages (.gitlab-ci.yml).
# Never commit them: a fork that publishes without running build.py serves a site
# whose data files 404, and the app dies on `DATA is not defined`.
docs/data.json
docs/data_inline.js
docs/resolved_concept_ids.json
docs/concept_sets_resolved/

# Artefacts of the v2 branch (apps/, packages/, legacy/) that stay on disk when
# switching back to main: build outputs, dependencies, caches, agent worktrees.
legacy/
node_modules/
.venv/
dist/
*.egg-info/
*.tsbuildinfo
.turbo/
.pytest_cache/
.ruff_cache/
apps/web/public/duckdb/
apps/web/public/coi-serviceworker.js
.env
.env.*
!.env.example
*.db
*.sqlite
.claude/worktrees/
.claude/settings.local.json
